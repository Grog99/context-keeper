# =============================================================================
# Context Keeper — konfiguracja (12-factor). KANON configu.
# Skopiuj do `.env` i dostosuj:  cp .env.example .env
# `.env` NIGDY nie trafia do repo (jest w .gitignore).
#
# Wartości progów/limitów to knoby dostrajane na realnych danych (PRD §11).
# =============================================================================

NODE_ENV=development

# --- Sieć / porty ------------------------------------------------------------
# app słucha plain HTTP na własnym origin; TLS i rozdział ekspozycji robi proxy (§9).
# W docker-compose te wartości to zarazem port PUBLIKOWANY NA HOŚCIE (lewa strona `ports:`) —
# zmień je gdy 3000/3001 są u Ciebie zajęte (port w kontenerze zostaje 3000/3001).
PORT_MCP=3000
PORT_DASHBOARD=3001
# true gdy TLS terminowany upstream (bring-your-own-proxy, tryb B) — honoruj X-Forwarded-*.
TRUST_PROXY=false

# --- Baza --------------------------------------------------------------------
# Dla dev NA HOŚCIE (pnpm dev / db:migrate:dev / drizzle-kit): łączymy się po localhost.
# W kontenerze `app` DATABASE_URL jest składany przez docker-compose z części poniżej.
DATABASE_URL=postgres://ck:ck@localhost:5432/context_keeper
# Używane przez docker-compose (serwis db + składanie DATABASE_URL dla app):
POSTGRES_USER=ck
POSTGRES_PASSWORD=ck
POSTGRES_DB=context_keeper
# Port PostgreSQL publikowany na hoście — zmień gdy 5432 jest u Ciebie zajęty (np. lokalna instancja PG).
DB_PORT=5432
# Auto-migracja przy starcie appki (in-process, przed nasłuchem; advisory-lock serializuje repliki).
# true (default) = nie musisz odpalać `docker compose run --rm app node dist/db/migrate.js`.
# false = migracje uruchamiasz sam (patrz README "manualnie").
DB_AUTO_MIGRATE=true

# --- Embeddingi (provider + preset) -----------------------------------------
# Presety deploy-time (spinają PROVIDER + MODEL + DIM spójnie); EMBEDDING_PRESET to tylko
# wygoda zapisu — PROVIDER/MODEL/DIM zostają autorytatywne i muszą być z nim spójne (patrz env.ts):
#   multilingual (default): local, bge-m3,                DIM=1024 — treść mieszana PL/EN
#   english (lean):         local, bge-small-en-v1.5,     DIM=384  — treść EN-only
#   api:                    api,   OpenAI text-embedding-3-small, DIM=1024 — offload compute
#                           (Matryoshka: `dimensions` w żądaniu skraca+renormalizuje natywne 1536 do 1024)
# UWAGA: `english` wymaga wymiaru INNEGO niż fizyczna kolumna `vector(1024)` — Faza 3 nie zawiera
# migracji cross-dimension (ALTER COLUMN + rebuild HNSW), więc realnie działają `multilingual`
# (domyślny) i `api` (oba na DIM=1024). Zmiana presetu pod istniejącymi danymi = migracja
# `reembed`, nie edycja DIM.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_PRESET=
# TEI sidecar (provider=local) — w Compose wskazuje na serwis `embeddings`; z hosta użyj localhost.
EMBEDDING_BASE_URL=http://embeddings:80
# Baza zewnętrznego API (provider=api), np. https://api.openai.com/v1/embeddings.
EMBEDDING_API_URL=
# Twardy budżet czasu na embedding przy save (potem `pending` bez embeddingu, doembed przy akceptacji).
EMBEDDING_SAVE_TIMEOUT_MS=1500
# Budżet czasu ramienia wektorowego przy search — przekroczony/timeout = fail-open (FTS-only).
EMBEDDING_QUERY_TIMEOUT_MS=800

# --- Hybrid retrieval (§6 tech-stack, FR-R2-R5) ------------------------------
RRF_K=60
SEARCH_TOP_K=10
SEARCH_VECTOR_CANDIDATES=50
# Age-decay dla kind=event (roadmap v1.2, "kind=event episodic") — wykładniczy half-life w dniach,
# aplikowany post-RRF WYŁĄCZNIE do kind=event (zero wpływu na ranking fact/document).
EVENT_DECAY_HALFLIFE_DAYS=30

# --- Limity wejścia (FR-V1) --------------------------------------------------
BODY_MAX_FACT=8192
BODY_MAX_DOCUMENT=262144
# event (roadmap v1.2) — symetryczny z BODY_MAX_FACT (krótkie notatki, nie dokumenty).
BODY_MAX_EVENT=8192
TAGS_MAX=10
TAG_MAX_LEN=40

# --- Nocny job (§8, Faza 6) ---------------------------------------------------
# CRON/TZ to kontrakt dla ZEWNĘTRZNEGO schedulera (`install.sh` je generuje, host crontab to
# osobny krok operatora) — `run-nightly` CLI ich nie czyta.
NIGHTLY_CRON=0 3 * * *
NIGHTLY_TZ=Europe/Warsaw
# Próg "near-identical" dla ANN dedup (dystans kosinusowy, 0=identyczne) — celowo wąski, dostrajany
# na realnych danych (PRD §11).
NIGHTLY_DEDUP_DISTANCE=0.05
# Liczba sąsiadów pobieranych per fakt zanim odfiltrujemy do NIGHTLY_DEDUP_DISTANCE.
NIGHTLY_ANN_NEIGHBORS=5
# Rozmiar strony paginacji przy skanowaniu approved facts.
NIGHTLY_BATCH_SIZE=50
# Prune (RecencyPruneScorer v1): minimalny wiek (dni) zanim pamięć w ogóle podlega ocenie.
NIGHTLY_PRUNE_MIN_AGE_DAYS=30
# Prune: ile dni bez odczytu (albo nigdy nieodczytana) liczy się jako "stale".
NIGHTLY_PRUNE_STALE_DAYS=90
# Prune: maksymalny access_count kwalifikujący do usunięcia (0 = tylko faktycznie nietknięte).
NIGHTLY_PRUNE_MAX_ACCESS=0
# Flood backstop: limit NOWYCH proposali tworzonych w jednym przebiegu (reszta wraca w kolejnym).
NIGHTLY_MAX_PROPOSALS_PER_RUN=200
# Retencja `search_events` (ekran "Pomiary", roadmap v1.1) — raw rows starsze niż N dni pruned
# nocnym jobem (ten sam przebieg co dedup/prune pamięci, bez osobnego schedulera).
SEARCH_EVENTS_RETENTION_DAYS=90

# --- Backup (NFR-5, §9 tech-stack) -------------------------------------------
# `infra/backup.sh` (pg_dump -Fc + retencja + offsite) czyta te zmienne bezpośrednio z shella
# (source .env). Appka ich NIE czyta — kontrakt dla skryptu + przyszłego host-side schedulera
# (Faza 8, jak NIGHTLY_CRON/TZ). Runbook pełny: README "Backup / Restore".
BACKUP_DIR=./backups
# Tiered retention: 7 dni "daily" (zachowaj wszystko) + 4 tygodnie "weekly" (po jednym, najnowszym
# dumpie na tydzień ISO) = cutoff kasowania wyprowadzony, domyślnie 7+4*7=35 dni. WEEKLY_WEEKS=0
# degraduje łagodnie do płaskiej retencji DAILY_DAYS dni.
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_WEEKS=4
# Kontrakt dla ZEWNĘTRZNEGO schedulera (Faza 8), jak NIGHTLY_CRON/TZ — godzinę po nightly (0 3),
# żeby się nie nakładały. `infra/backup.sh` ich nie czyta, odpala się natychmiast po wywołaniu.
BACKUP_CRON=0 4 * * *
BACKUP_TZ=Europe/Warsaw
# Offsite — pluggable hook, oba opcjonalne (brak obu = tylko lokalny dump, retencja i tak działa).
# Gdy oba ustawione, BACKUP_OFFSITE_CMD ma pierwszeństwo nad RCLONE_REMOTE.
#
# Opcja A — rclone (rekomendowana: jeden statyczny binary, 70+ backendów). Skonfiguruj remote raz:
#   rclone config   # np. nazwij remote "ck-offsite" (S3/B2/GCS/SFTP/...)
# potem ustaw:
# RCLONE_REMOTE=ck-offsite:context-keeper-backups
RCLONE_REMOTE=
# Opcja B — dowolna własna komenda. Wołana jako `sh -c "$BACKUP_OFFSITE_CMD" sh "$1"`, gdzie "$1"
# to ścieżka do świeżego dumpa. Przykład (kopia na inny host przez scp):
# BACKUP_OFFSITE_CMD=scp "$1" backup-host:/srv/ck-backups/
BACKUP_OFFSITE_CMD=

# --- Rate limiting per token (§10) -------------------------------------------
RATE_LIMIT_SAVE_PER_MIN=20
RATE_LIMIT_SEARCH_PER_MIN=120
RATE_LIMIT_GET_PER_MIN=240
# Throttle PRE-AUTH per IP na /mcp (review bezpieczeństwa C1) — backstop DoS zanim BearerGuard dotknie
# DB przy każdym (dobrze sformatowanym, ale nieważnym) tokenie. Per-IP fidelity wymaga TRUST_PROXY=true
# za zaufanym, jedynym proxy-ingres; bez tego = coarse limit per-instancja. Osobny od limitów per-token.
RATE_LIMIT_MCP_IP_PER_MIN=300

# --- Dashboard / sesja (używane od Fazy 5; WYMAGANE w produkcji) -------------
# W produkcji `install.sh` generuje losowe wartości. Poniżej placeholdery DEV — ZMIEŃ na prod.
DASHBOARD_PASSWORD=changeme-dev
SESSION_SECRET=dev-session-secret-change-me
# Czas życia sesji (godziny) i nazwa cookie sesji (podpisany, stateless — §10 tech-stack).
SESSION_TTL_HOURS=12
DASHBOARD_COOKIE_NAME=ck_session

# --- Compose / edge ----------------------------------------------------------
# Profile Compose (ustawiane przez `install.sh`): local-embeddings, edge-proxy.
# Przykład: COMPOSE_PROFILES=local-embeddings,edge-proxy
COMPOSE_PROFILES=
# Tylko tryb A (bundled Caddy): domena + email dla Let's Encrypt.
ACME_DOMAIN=
ACME_EMAIL=
# Kanoniczny publiczny origin powierzchni `/mcp` (bez ścieżki), np. https://ck-mcp.example.com —
# używany WYŁĄCZNIE do renderowania snippetu ekranu dashboardu "Onboarding" (nie do routingu appki).
# Nieustawione -> fallback na `https://${ACME_DOMAIN}` (tylko tryb A); bez obu -> ekran pokazuje
# placeholder `https://<your-mcp-host>` i notatkę, żeby ustawić tę zmienną (albo edytować ręcznie).
PUBLIC_MCP_URL=
# Porty publikowane na hoście przez bundled Caddy (profil edge-proxy) — zmień gdy 80/443
# są zajęte (np. inny reverse-proxy na hoście). HTTPS_PORT obsługuje TCP i UDP (HTTP/3).
HTTP_PORT=80
HTTPS_PORT=443
