{
  "permissions": {
    "ask": [
      "Bash(docker compose down*)",
      "Bash(docker-compose down*)",
      "Bash(docker compose rm*)",
      "Bash(docker-compose rm*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "PowerShell(docker compose down*)",
      "PowerShell(docker-compose down*)",
      "PowerShell(docker compose rm*)",
      "PowerShell(docker-compose rm*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker volume prune*)",
      "PowerShell(docker system prune*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git worktree add *)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-install.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/grep-windows-path-guard.mjs\""
          }
        ]
      }
    ]
  }
}
